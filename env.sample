# OPENDART (dart.fss.or.kr)
# Option A: copy this file to `.env` in the repo root (Dart_KAM_dashboard/.env) and fill DART_API_KEY.
# Option B: set User env var and fully restart Cursor/terminal so new processes inherit it.
# Option C: each PowerShell session:  $env:DART_API_KEY = "your-key"
DART_API_KEY=
# Optional overrides
# DART_API_BASE=https://opendart.fss.or.kr/api
# Optional: keep SQLite off OneDrive to reduce "database is locked" errors
# DART_KAM_DATA_DIR=C:/Users/You/AppData/Local/dart_kam_data
# DART_YEARS_BACK=3
# DART_LIST_CHUNK_DAYS=90
# DART_REQUEST_SLEEP=0.12
# DART_PBLNTF_TY=F
# DART_PBLNTF_DETAIL=F001,F002,F003
# DART_LAST_REPRT_AT=Y
# 법인구분 CSV (Y=코스피, K=코스닥, N=코넥스, E=기타). 기본 Y,K (상장사).
# DART_CORP_CLS=Y,K
# DART_END_DATE=20260514
# OPENDART HTTP 요청마다 터미널 로그 (인증키 마스킹). CLI: dart_kam ... --verbose-http
# DART_HTTP_LOG=1
